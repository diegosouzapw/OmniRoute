FROM node:24-bookworm-slim

ENV NODE_ENV=production
ENV DATA_DIR=/app/data
ENV PORT=8080
WORKDIR /app

# Install only from the committed lockfile. No .env or credential is copied
# into the image; Railway/Render inject secrets at runtime.
COPY package.json package-lock.json ./
RUN mkdir -p open-sse
COPY open-sse/package.json ./open-sse/package.json
# The repository lockfile intentionally retains legacy peer ranges (for example
# marked@18 with marked-terminal@7 and ESLint 10 plugin ranges). This image only
# runs the monitor and does not alter those dependencies; legacy peer resolution
# makes the committed lockfile installable without changing application manifests.
# Optional platform packages must remain installed: tsx/esbuild needs the
# Linux-native @esbuild/linux-x64 binary at runtime.
RUN npm ci --legacy-peer-deps --include=dev --ignore-scripts --no-audit --no-fund \
  && npm cache clean --force

COPY scripts/solana ./scripts/solana
COPY src/lib/telegram ./src/lib/telegram

RUN mkdir -p /app/data \
  && chown -R node:node /app
USER node

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "--import", "tsx/esm", "scripts/solana/tokenMonitor.ts"]
