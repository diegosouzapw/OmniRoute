      "replacement": "um ",
      "context": "all",
      "category": "structural",
      "minIntensity": "lite"
    },
    {
      "name": "de_connectors",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:ausserdem|außerdem|zusaetzlich|zusätzlich|darueber hinaus|darüber hinaus)(?![\\p{L}\\p{N}_])\\s*",
      "replacement": "auch ",
      "context": "all",
      "category": "structural",
      "minIntensity": "lite",
      "flags": "giu"
    },
    {
      "name": "de_emphasis",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:sehr|wirklich|extrem|ziemlich)\\s+(?=[a-zäöüß])",
      "replacement": "",
      "context": "all",
