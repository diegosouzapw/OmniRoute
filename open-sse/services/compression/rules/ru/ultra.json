{
  "language": "ru",
  "category": "ultra",
  "rules": [
    {
      "name": "ultra_compression_conjunctions",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:однако|тем не менее|в то время как)(?![\\p{L}\\p{N}_])\\s*",
      "replacement": "—",
      "context": "all",
      "category": "ultra",
      "minIntensity": "ultra",
      "flags": "giu"
    },
    {
      "name": "ultra_compression_articles",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:является|представляет собой)(?![\\p{L}\\p{N}_])\\s*",
      "replacement": "—",
      "context": "all",
      "category": "ultra",
      "minIntensity": "ultra",
      "flags": "giu"
    },
    {
      "name": "ultra_compression_verbs",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:необходимо|требуется|нужно)(?![\\p{L}\\p{N}_])\\s*",
      "replacement": "",
      "context": "all",
      "category": "ultra",
      "minIntensity": "ultra",
      "flags": "giu"
    },
    {
      "name": "ultra_punctuation",
      "pattern": "[,:;]\\s+",
      "replacement": " ",
      "context": "all",
      "category": "ultra",
      "minIntensity": "ultra"
    },
    {
      "name": "ultra_lowercase",
      "pattern": "(?<=\\.)\\s+([А-ЯЁ])",
      "replacement": " $1",
      "context": "all",
      "category": "ultra",
      "minIntensity": "ultra"
    }
  ]
}
