{
  "language": "ru",
  "category": "filler",
  "rules": [
    {
      "name": "pleasantries",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:конечно|с радостью|рад помочь|могу помочь|обязательно|безусловно|разумеется)(?![\\p{L}\\p{N}_])[,.!?\\s]*",
      "replacement": "",
      "context": "all",
      "category": "filler",
      "minIntensity": "lite",
      "flags": "giu"
    },
    {
      "name": "polite_framing",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:пожалуйста|если хотите|если можно|будьте добры|будьте любезны|прошу вас)(?![\\p{L}\\p{N}_])[,.!?\\s]*",
      "replacement": "",
      "context": "all",
      "category": "filler",
      "minIntensity": "lite",
      "flags": "giu"
    },
    {
      "name": "verbal_wrapping",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:давайте разберём|давайте посмотрим|попробуем разобраться|постараюсь помочь)(?![\\p{L}\\p{N}_])[,.!?\\s]*",
      "replacement": "",
      "context": "assistant",
      "category": "filler",
      "minIntensity": "lite",
      "flags": "giu"
    },
    {
      "name": "hedging",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:возможно|наверное|может быть|скорее всего|вероятно|видимо|похоже)(?![\\p{L}\\p{N}_])[,.!?\\s]*",
      "replacement": "",
      "context": "all",
      "category": "filler",
      "minIntensity": "lite",
      "flags": "giu"
    },
    {
      "name": "filler_adverbs",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:в целом|на самом деле|в принципе|как правило|по сути|фактически|буквально)(?![\\p{L}\\p{N}_])[,.!?\\s]*",
      "replacement": "",
      "context": "all",
      "category": "filler",
      "minIntensity": "lite",
      "flags": "giu"
    },
    {
      "name": "empty_qualifiers",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:удобный|хороший|эффективный|мощный|отличный|прекрасный)(?!\\s+(?:вариант|способ|решение|метод|инструмент))(?![\\p{L}\\p{N}_])",
      "replacement": "",
      "context": "all",
      "category": "filler",
      "minIntensity": "lite",
      "flags": "giu"
    },
    {
      "name": "redundant_openers",
      "pattern": "^(?:Привет|Здравствуйте|Добрый день|Доброе утро|Добрый вечер)\\s*[,.!?\\s]?\\s*",
      "replacement": "",
      "context": "user",
      "category": "filler",
      "minIntensity": "lite"
    },
    {
      "name": "excessive_gratitude",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:Большое спасибо|Огромное спасибо|Спасибо заранее|Заранее благодарю|Очень признателен)(?![\\p{L}\\p{N}_])[,.!?\\s]*",
      "replacement": "",
      "context": "all",
      "category": "filler",
      "minIntensity": "lite",
      "flags": "giu"
    },
    {
      "name": "softeners",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:немного|немножко|чуть-чуть|слегка|несколько|как-то)(?![\\p{L}\\p{N}_])\\s*",
      "replacement": "",
      "context": "all",
      "category": "filler",
      "minIntensity": "lite",
      "flags": "giu"
    },
    {
      "name": "assistant_fillers",
      "pattern": "^(?:Вот|Ниже|Это|Здесь)\\s+(?:есть|находится)?\\s*",
      "replacement": "",
      "context": "assistant",
      "category": "filler",
      "minIntensity": "lite"
    }
  ]
}
